# Copy to .env.local. "local" keeps accounts and weddings in the browser so you can
# try the app without Firebase. Use "firebase" when the project below is yours.
NEXT_PUBLIC_DATA_MODE=local

# Only used when NEXT_PUBLIC_DATA_MODE is unset or "firebase".
# The defaults in src/lib/firebase-config.ts point at the original project
# (the-big-day-31aox). Replace them for a new Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Digital invitations can be previewed and copied without these.
# Sending email returns a clear error until they are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Genkit is not used by any screen yet.
GOOGLE_GENAI_API_KEY=
